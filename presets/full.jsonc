// Full — everything: OS/DE/WM, hardware, network, packages, colors, plus the default "large" distro
// ASCII logo
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "builtin", "padding": { "top": 0, "right": 1 } },
  "display": {
    "separator": " | " ,
    "key": { "width": 15 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{6}{7}{8}", "color": { "user": "green", "at": "green", "host": "green" } },
    "break",
    { "type": "os", "key": "DISTRO", "keyColor": "yellow" },
    { "type": "kernel", "key": "KERNEL", "keyColor": "yellow" },
    { "type": "packages", "key": "PACKAGES", "keyColor": "yellow" },
    {
      "type": "command",
      "key": "OS AGE",
      "keyColor": "yellow",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo \"$days_difference days\""
    },
    { "type": "shell", "key": "SHELL", "keyColor": "yellow" },
    "break",
    { "type": "de", "key": "DE", "keyColor": "blue" },
    { "type": "wm", "key": "WM", "keyColor": "blue" },
    { "type": "terminal", "key": "TERMINAL", "keyColor": "blue" },
    { "type": "font", "key": "FONT", "keyColor": "blue" },
    "break",
    { "type": "host", "key": "SYSTEM", "keyColor": "green" },
    { "type": "cpu", "key": "CPU", "keyColor": "green" },
    { "type": "gpu", "key": "GPU", "keyColor": "green" },
    { "type": "display", "key": "DISPLAY", "keyColor": "green" },
    { "type": "memory", "key": "MEMORY", "keyColor": "green" },
    { "type": "swap", "key": "SWAP", "keyColor": "green" },
    { "type": "disk", "key": "DISK", "keyColor": "green", "folders": "/" },
    { "type": "battery", "key": "BATTERY", "keyColor": "green" },
    { "type": "uptime", "key": "UPTIME", "keyColor": "green" },
    "break",
    { "type": "localIP", "key": "LOCAL IP", "keyColor": "magenta" },
    "break",
    { "type": "colors", "symbol": "block", "paddingLeft": 1 },
    "break"
  ]
}
