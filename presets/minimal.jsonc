// Minimal — no logo, just the essentials. Fits easily in 80x24.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "none" },
  "display": {
    "separator": " : ",
    "key": { "width": 9 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{6}{7}{8}", "color": { "user": "cyan", "at": "white", "host": "magenta" } },
    "break",
    { "type": "os", "key": "OS", "keyColor": "red" },
    { "type": "kernel", "key": "KERNEL", "keyColor": "yellow" },
    { "type": "packages", "key": "PACKAGES", "keyColor": "green" },
    { "type": "de", "key": "DE", "keyColor": "cyan" },
    { "type": "wm", "key": "WM", "keyColor": "blue" },
    { "type": "shell", "key": "SHELL", "keyColor": "magenta" },
    { "type": "terminal", "key": "TERM", "keyColor": "red" },
    { "type": "font", "key": "FONT", "keyColor": "red" },
    { "type": "cpu", "key": "CPU", "keyColor": "yellow" },
    { "type": "memory", "key": "MEMORY", "keyColor": "green" },
    { "type": "disk", "key": "DISK", "keyColor": "cyan", "folders": "/" },
    { "type": "battery", "key": "BATTERY", "keyColor": "blue" },
    { "type": "uptime", "key": "UPTIME", "keyColor": "magenta" },
    { "type": "colors", "symbol": "block", "paddingLeft": 1 },
    "break"
  ]
}
