// Compact + IP — small distro ASCII logo + balanced info (+GPU + local network IP).
// Uses the "small" logo variant so it still fits narrow terminal windows.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "small", "padding": { "top": 0, "right": 1 } },
  "display": { "separator": " | " },
  "modules": [
    "title",
    "break",
    { "type": "os", "key": "OS", "keyColor": "red" },
    { "type": "kernel", "key": "KERNEL", "keyColor": "red" },
    { "type": "shell", "key": "SHELL", "keyColor": "red" },
    "break",
    { "type": "cpu", "key": "CPU", "keyColor": "yellow" },
    { "type": "gpu", "key": "GPU", "keyColor": "yellow" },
    { "type": "memory", "key": "MEMORY", "keyColor": "yellow" },
    { "type": "swap", "key": "SWAP", "keyColor": "yellow" },
    { "type": "disk", "key": "DISK", "keyColor": "yellow", "folders": "/" },
    "break",
    { "type": "de", "key": "DE", "keyColor": "green" },
    { "type": "wm", "key": "WM", "keyColor": "green" },
    { "type": "terminal", "key": "TERMINAL", "keyColor": "green" },
    { "type": "font", "key": "FONT", "keyColor": "green" },
    "break",
    { "type": "battery", "key": "BATTERY", "keyColor": "cyan" },
    { "type": "uptime", "key": "UPTIME", "keyColor": "cyan" },
    { "type": "packages", "key": "PACKAGES", "keyColor": "cyan" },
    "break",
    { "type": "localIP", "key": "LOCAL IP", "keyColor": "magenta" },
    "break",
  ]
}
